# Local run: no Google Cloud, no GitLab. Export these in your shell (or load them with your tool of choice).
# Never put real tokens here: the cloud setup needs none in files (see SETUP.md).

# The app (uvicorn app.main:app --port 8000)
APP_STORE=memory                          # in-memory store instead of Firestore
APP_API_KEY=dev                           # key for write endpoints, sent as the X-API-Key header
CONTROL_ROOM_URL=http://127.0.0.1:8001    # where the app's /status and header link point
# APP_FLAGS_OFF=custom_alias,link_preview # kill switches to turn off (flag names from promises/features/*.yaml)
# APP_LOG_REQUESTS=0                      # quiet the JSON request logs

# The control room (uvicorn control.main:app --port 8001)
APP_URL=http://127.0.0.1:8000             # where the control room links back to the app
# APP_STORE=memory applies here too
