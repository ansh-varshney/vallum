{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.com/gitlab-ai-hackathon/transcend-october-2026/43503198/vallum/vallum/schema/card.json",
  "title": "Vallum Feature Card",
  "type": "object",
  "required": ["feature", "kind", "tier", "priority", "owns", "promises"],
  "additionalProperties": false,
  "properties": {
    "feature": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "issue": {"type": ["integer", "null"]},
    "kind": {"type": "string"},
    "tier": {"enum": ["core", "standard", "experimental"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "owns": {
      "type": "object",
      "required": ["routes", "files"],
      "additionalProperties": false,
      "properties": {
        "routes": {"type": "array", "items": {"type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$"}},
        "files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "flag": {"type": ["string", "null"]},
    "promises": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "behavior": {"$ref": "#/$defs/promiseList"},
        "speed": {"$ref": "#/$defs/promiseList"},
        "reliability": {"$ref": "#/$defs/promiseList"},
        "security": {"$ref": "#/$defs/promiseList"},
        "data": {"$ref": "#/$defs/promiseList"},
        "compatibility": {"$ref": "#/$defs/promiseList"},
        "cost": {"$ref": "#/$defs/promiseList"},
        "operability": {"$ref": "#/$defs/promiseList"}
      }
    },
    "watch": {"type": "array", "items": {"$ref": "#/$defs/watchPromise"}},
    "learned": {"type": "array", "items": {"$ref": "#/$defs/promise"}}
  },
  "$defs": {
    "promiseList": {"type": "array", "items": {"$ref": "#/$defs/promise"}},
    "promise": {
      "type": "object",
      "required": ["id", "says", "where", "severity"],
      "oneOf": [
        {"required": ["steps"]},
        {"required": ["measure"]},
        {"required": ["scan"]},
        {"required": ["static"]}
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"},
        "says": {"type": "string", "minLength": 5},
        "type": {"enum": ["behavior", "speed", "reliability", "security", "data", "compatibility", "cost", "operability"]},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "measure": {"type": "string"},
        "scan": {"type": "object"},
        "static": {"type": "object"},
        "judge": {
          "type": "object",
          "properties": {
            "min_samples": {"type": "integer", "minimum": 1},
            "compare_old": {"type": "boolean"}
          }
        },
        "where": {"type": "array", "minItems": 1, "items": {"enum": ["mr", "drive", "live"]}},
        "severity": {"enum": ["blocker", "major", "minor"]},
        "replay": {"type": "boolean"},
        "learned_from": {"type": "string"},
        "applies_to": {}
      }
    },
    "watchPromise": {
      "allOf": [
        {"$ref": "#/$defs/promise"},
        {"required": ["type", "raised_by", "concern"],
         "properties": {"raised_by": {"type": "string"}, "concern": {"type": "string"}, "expires": {"const": "after_release"}}}
      ]
    }
  }
}
